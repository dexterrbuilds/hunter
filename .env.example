# Placeholder values only. Never commit real credentials.
SOLANA_NODE_RPC_ENDPOINT=https://rpc.example.invalid/?api-key=YOUR_RPC_API_KEY
SOLANA_NODE_WSS_ENDPOINT=wss://rpc.example.invalid/?api-key=YOUR_RPC_API_KEY

GEYSER_ENDPOINT=geyser.example.invalid:443
GEYSER_API_TOKEN=YOUR_GEYSER_API_TOKEN
GEYSER_AUTH_TYPE=x-token

# Maximum-performance feeds and senders. These are placeholders only and are
# unused unless a private maximum-performance config explicitly references them.
RABBITSTREAM_ENDPOINT=rabbitstream.ams.shyft.to:443
RABBITSTREAM_API_KEY=YOUR_RABBITSTREAM_API_KEY
TRITON_RIPTIDE_ENDPOINT=YOUR_TRITON_RIPTIDE_GRPC_ENDPOINT
TRITON_API_KEY=YOUR_TRITON_API_KEY
TRITON_JET_ENDPOINT=https://YOUR_TRITON_CASCADE_OR_JET_ENDPOINT/YOUR_TOKEN
HELIUS_SENDER_MAX_ENDPOINT=https://YOUR_PROVIDER_ISSUED_SENDER_MAX_ENDPOINT
JITO_AMSTERDAM_ENDPOINT=https://amsterdam.mainnet.block-engine.jito.wtf/api/v1/transactions

# Base58-encoded Solana keypair. Keep the real value only in your local .env.
SOLANA_PRIVATE_KEY=YOUR_BASE58_SOLANA_PRIVATE_KEY

# Reserved for a later milestone; Telegram is not implemented yet.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
