# Placeholder values only. Never commit real credentials.
SOLANA_NODE_RPC_ENDPOINT=https://rpc.example.invalid/?api-key=YOUR_RPC_API_KEY
SOLANA_NODE_WSS_ENDPOINT=wss://rpc.example.invalid/?api-key=YOUR_RPC_API_KEY

GEYSER_ENDPOINT=geyser.example.invalid:443
GEYSER_API_TOKEN=YOUR_GEYSER_API_TOKEN
GEYSER_AUTH_TYPE=x-token

# Base58-encoded Solana keypair. Keep the real value only in your local .env.
SOLANA_PRIVATE_KEY=YOUR_BASE58_SOLANA_PRIVATE_KEY

# Reserved for a later milestone; Telegram is not implemented yet.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
